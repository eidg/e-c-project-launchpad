# E C Project Launchpad Environment Configuration Template
# Copy this file to .env and update the values for your environment

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/e_c_project_launchpad

# JWT Authentication Secrets (CHANGE THESE IN PRODUCTION!)
ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars

# Server Configuration
NODE_ENV=development
PORT=4000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000

# Database Connection (for local development)
POSTGRES_DB=e_c_project_launchpad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AI Integration
# Add your AI API key to enable real AI responses (optional - fallback responses work without keys)
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Chat Graph Routing
# Route backend chat via LangGraph chat graph (default true)
USE_CHAT_GRAPH=true

# LangGraph Service Configuration
LANGGRAPH_SERVICE_URL=http://langgraph.local:5000

# Security Notes:
# - Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# - Never commit .env files to version control
# - Use different secrets for each environment (dev, staging, production)
